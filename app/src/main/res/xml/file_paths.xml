<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Context.getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS) maps to external-files-path -->
    <external-files-path name="external_files_download" path="Download" />
    <external-files-path name="external_files_all" path="." />

    <!-- Standard public Downloads directory -->
    <external-path name="external_download" path="Download" />
    <external-path name="external_root" path="." />

    <!-- External cache & Internal cache -->
    <external-cache-path name="external_cache" path="." />
    <cache-path name="internal_cache" path="." />
    <files-path name="internal_files" path="." />
</paths>
